# Copy to .env and fill in. NEVER commit .env.
# PRIMARY LLM — preferred endpoint (OpenAI-compatible). Used first, always.
#   local vLLM:      https://your-vllm-host/v1
#   Google Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenAI:          https://api.openai.com/v1
GRAPHRAG_LLM_BASE_URL=https://your-vllm-host/v1
GRAPHRAG_LLM_API_KEY=your-key
GRAPHRAG_LLM_MODEL=your-model-id
# "thinking" models (Gemini 2.5, o-series): set "none" so internal reasoning does not
# consume the output budget and truncate the SPARQL. Leave EMPTY for plain vLLM.
GRAPHRAG_LLM_REASONING_EFFORT=
# Local Qwen3-style "thinking" models that ignore reasoning_effort: set to
# "<think></think>" to prefill an empty reasoning block and SKIP thinking (~20x faster).
# Leave EMPTY for non-thinking models and for API models (Gemini/OpenAI).
GRAPHRAG_LLM_THINK_PREFILL=

# FALLBACK LLM — used ONLY when the primary is unreachable (e.g. free Gemini when the
# local server is down). Leave BASE_URL empty to disable fallback (primary only).
GRAPHRAG_LLM_FALLBACK_BASE_URL=
GRAPHRAG_LLM_FALLBACK_API_KEY=
GRAPHRAG_LLM_FALLBACK_MODEL=
GRAPHRAG_LLM_FALLBACK_REASONING_EFFORT=
GRAPHRAG_LLM_FALLBACK_THINK_PREFILL=

# GraphDB
GRAPHRAG_GRAPHDB_URL=http://localhost:7200
GRAPHRAG_GRAPHDB_REPO=graphrag
