# Copy to .env and fill in. NEVER commit .env.
# LLM — OpenAI-compatible endpoint (e.g. local vLLM server)
GRAPHRAG_LLM_BASE_URL=https://your-vllm-host/v1
GRAPHRAG_LLM_API_KEY=your-rotated-key
GRAPHRAG_LLM_MODEL=your-model-id

# GraphDB
GRAPHRAG_GRAPHDB_URL=http://localhost:7200
GRAPHRAG_GRAPHDB_REPO=graphrag
